<UserControl x:Class="DeskNest.App.Controls.ZoneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             MouseEnter="OnCardMouseEnter"
             MouseLeave="OnCardMouseLeave">
    <UserControl.Resources>
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1F526170" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#34526170" />
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeHandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="#66758496" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border x:Name="ThumbSurface" Width="3" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#D076D7C4" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#FF53CDB6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="3" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <primitives:Thumb Style="{StaticResource SlimThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="CardBorder"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="22" ShadowDepth="5" Opacity="0.2" Color="#06101A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="HeaderSurface" Grid.Row="0" Background="#EDF7F9FC" CornerRadius="10,10,0,0"
                        MouseEnter="OnHeaderMouseEnter" MouseLeave="OnHeaderMouseLeave"
                        MouseLeftButtonDown="OnHeaderMouseDown"
                        MouseMove="OnHeaderMouseMove"
                        MouseLeftButtonUp="OnHeaderMouseUp">
                    <Grid>
                        <Grid x:Name="HeaderTitleHost" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="14,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="HeaderTitleTranslation" />
                            </Grid.RenderTransform>
                            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       MouseLeftButtonDown="OnTitleDoubleClick" />
                            <TextBox x:Name="TitleEditor" Visibility="Collapsed" Height="29" MinWidth="120"
                                     VerticalContentAlignment="Center" Padding="7,0"
                                     Background="#DFFFFFFF"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                     LostKeyboardFocus="OnTitleEditorLostFocus"
                                     KeyDown="OnTitleEditorKeyDown" />
                        </Grid>

                        <StackPanel x:Name="HeaderAccessories" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,9,0" Opacity="0" IsHitTestVisible="False">
                            <Button x:Name="CollapseButton" Style="{StaticResource HeaderActionButtonStyle}"
                                    ToolTip="折叠/展开" Click="OnCollapseClick">
                                <Path x:Name="CollapseChevron" Data="M 2,6 L 6,2 L 10,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource HeaderActionButtonStyle}"
                                    ToolTip="分区菜单" Click="OnMoreClick">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="3" Height="3" Margin="2,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border x:Name="HeaderDivider" Height="1" VerticalAlignment="Bottom" Background="#14526170" />
                    </Grid>
                </Border>

                <Grid x:Name="BodyArea" Grid.Row="1" ClipToBounds="True"
                      MouseRightButtonUp="OnBodyRightButtonUp">
                    <ScrollViewer x:Name="BodyScroller" Margin="10,4,10,12"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnBodyScrollChanged">
                        <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                    <ScrollBar x:Name="SlimScrollBar" Orientation="Vertical" HorizontalAlignment="Right"
                               Margin="0,9,5,10" Visibility="Collapsed"
                               Style="{StaticResource SlimScrollBarStyle}" Scroll="OnSlimScroll"
                               LostMouseCapture="OnSlimScrollBarLostMouseCapture" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="MappingHighlight" IsHitTestVisible="False"
                Margin="1" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                CornerRadius="10" Opacity="0" Panel.ZIndex="5" />

        <Grid x:Name="ResizeLayer">
            <primitives:Thumb Tag="Left" Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                              Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="Right" Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                              Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="Top" Height="7" VerticalAlignment="Top" Cursor="SizeNS"
                              Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="Bottom" Height="7" VerticalAlignment="Bottom" Cursor="SizeNS"
                              Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />

            <primitives:Thumb Tag="TopLeft" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="TopRight" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="BottomLeft" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Cursor="SizeNESW" Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
            <primitives:Thumb Tag="BottomRight" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Cursor="SizeNWSE" Style="{StaticResource ResizeHandleStyle}" DragDelta="OnResizeDragDelta" />
        </Grid>
    </Grid>
</UserControl>
