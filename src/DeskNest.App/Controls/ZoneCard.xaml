<UserControl x:Class="DeskNest.App.Controls.ZoneCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver">
    <Grid>
        <Border x:Name="CardBorder"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Color="#05080D" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" CornerRadius="14,14,0,0"
                        MouseLeftButtonDown="OnHeaderMouseDown"
                        MouseMove="OnHeaderMouseMove"
                        MouseLeftButtonUp="OnHeaderMouseUp">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="AccentDot" Width="8" Height="8" Margin="0,0,10,0" />
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15"
                                       TextTrimming="CharacterEllipsis"
                                       MouseLeftButtonDown="OnTitleDoubleClick" />
                            <TextBox x:Name="TitleEditor" Visibility="Collapsed" Height="30"
                                     VerticalContentAlignment="Center" Background="#28FFFFFF"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                     LostKeyboardFocus="OnTitleEditorLostFocus"
                                     KeyDown="OnTitleEditorKeyDown" />
                        </Grid>
                        <Border Grid.Column="2" Padding="7,3" Margin="6,0" CornerRadius="9" Background="#22FFFFFF">
                            <TextBlock x:Name="CountText" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <Button x:Name="CollapseButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                Content="⌃" ToolTip="折叠/展开" Click="OnCollapseClick" />
                        <Button x:Name="MoreButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                Content="•••" ToolTip="分区菜单" Click="OnMoreClick" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="BodyScroller" Grid.Row="1" Margin="10,2,8,12"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>

        <primitives:Thumb x:Name="ResizeThumb" Width="18" Height="18"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,2,2" Cursor="SizeNWSE"
                          Background="Transparent" DragDelta="OnResizeDragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid>
                        <Path Data="M 3,14 L 14,3 M 8,14 L 14,8" Stroke="#80FFFFFF"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</UserControl>
