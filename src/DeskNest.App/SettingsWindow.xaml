<Window x:Class="DeskNest.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栖格设置" Width="540" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="#FA171D27" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="9" Opacity="0.4" Color="#03060A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,16,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="栖格设置" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="让桌面保持安静、有序" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Content="×" Click="OnCancelClick" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,4,28,0">
                <TextBlock Text="外观主题" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ComboBox x:Name="ThemeCombo" Height="38" Padding="10,4" Background="#22FFFFFF"
                          Foreground="#18202C" BorderBrush="#40FFFFFF">
                    <ComboBoxItem Content="跟随系统" Tag="System" />
                    <ComboBoxItem Content="深色" Tag="Dark" />
                    <ComboBoxItem Content="浅色" Tag="Light" />
                </ComboBox>

                <Grid Margin="0,24,0,7">
                    <TextBlock Text="分区透明度" FontWeight="SemiBold" />
                    <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="0.98" SmallChange="0.01" LargeChange="0.05"
                        ValueChanged="OnOpacityChanged" />

                <Grid Margin="0,24,0,7">
                    <TextBlock Text="图标尺寸" FontWeight="SemiBold" />
                    <TextBlock x:Name="IconSizeValue" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
                <Slider x:Name="IconSizeSlider" Minimum="32" Maximum="72" TickFrequency="4" IsSnapToTickEnabled="True"
                        ValueChanged="OnIconSizeChanged" />

                <Border Margin="0,28,0,0" Padding="14" CornerRadius="12" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="隐私与安全" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                                   Text="所有布局和映射仅保存在本机。栖格不会移动桌面文件，也不会连接网络。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="取消" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存设置" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
