<Window x:Class="DeskNest.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="栖格设置" Width="560" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FA171D27" />
        <SolidColorBrush x:Key="SettingsElevatedBrush" Color="#FF242C39" />
        <SolidColorBrush x:Key="SettingsInputBrush" Color="#FF202936" />
        <SolidColorBrush x:Key="SettingsSolidInputBrush" Color="#FF202936" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF7F9FC" />
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#FFAAB5C5" />
        <SolidColorBrush x:Key="SettingsStrokeBrush" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="SettingsHoverBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="SettingsTrackBrush" Color="#405B6878" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF14231F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ToolbarAlignmentChoiceStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceSurface" Padding="12,0" CornerRadius="10"
                                Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF14231F" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartupCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckSurface" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="CheckBoxSurface" Width="17" Height="17"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="5" BorderBrush="{DynamicResource SettingsStrokeBrush}"
                                        BorderThickness="1" />
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 14,3"
                                      Width="13" Height="13" HorizontalAlignment="Left"
                                      Margin="2,0,0,0" VerticalAlignment="Center"
                                      Stretch="Uniform" Stroke="#FF14231F" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <ContentPresenter Margin="28,0,0,0" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource SettingsTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SettingsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#2876D7C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SettingsInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <primitives:ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press">
                                <primitives:ToggleButton.Template>
                                    <ControlTemplate TargetType="primitives:ToggleButton">
                                        <Border x:Name="ComboSurface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="10">
                                            <Grid Margin="13,0,12,0">
                                                <TextBlock Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SettingsTextBrush}" />
                                                <Path x:Name="Arrow" Data="M 1,2 L 5,6 L 9,2"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Stroke="{DynamicResource SettingsMutedBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="180" Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0" Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </primitives:ToggleButton.Template>
                            </primitives:ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=ComboRoot}"
                                        Margin="0,5,0,0" Padding="5"
                                        Background="{DynamicResource SettingsElevatedBrush}"
                                        BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="#05080D" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="{DynamicResource SettingsTrackBrush}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Ellipse x:Name="ThumbCircle" Fill="{DynamicResource SettingsTextBrush}"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WallpaperOptionStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid>
                                <Border Height="25" VerticalAlignment="Bottom" Background="#B80C121A"
                                        CornerRadius="0,0,10,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <Border x:Name="SelectedMark" Width="20" Height="20" CornerRadius="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                                    <Path Data="M 3,7 L 6,10 L 12,3" Width="11" Height="11" Stretch="Uniform"
                                          Stroke="#FF14231F" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="1,0">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderDecreaseStyle}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <primitives:Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderIncreaseStyle}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource SettingsSurfaceBrush}"
            BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1" CornerRadius="10">
        <Grid x:Name="SettingsContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,0,20,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Text="栖格设置" FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource CloseButtonStyle}" Click="OnCancelClick" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="30,4,30,0">
                <TextBlock Text="外观主题" Style="{StaticResource SectionLabelStyle}" />
                <Border Height="42" Padding="4" CornerRadius="10"
                        Background="{DynamicResource SettingsSolidInputBrush}"
                        BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="ThemeSystemChoice" GroupName="AppearanceTheme"
                                     Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                     Content="跟随系统" Tag="System" Checked="OnThemeSelectionChanged" />
                        <RadioButton x:Name="ThemeDarkChoice" GroupName="AppearanceTheme"
                                     Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                     Content="深色" Tag="Dark" Checked="OnThemeSelectionChanged" />
                        <RadioButton x:Name="ThemeLightChoice" GroupName="AppearanceTheme"
                                     Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                     Content="浅色" Tag="Light" Checked="OnThemeSelectionChanged" />
                    </UniformGrid>
                </Border>

                <Grid Height="40" Margin="0,16,0,0">
                    <TextBlock Text="工具栏位置" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Padding="3" CornerRadius="10"
                            Background="{DynamicResource SettingsInputBrush}"
                            BorderBrush="{DynamicResource SettingsStrokeBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToolbarLeftChoice" GroupName="ToolbarAlignment"
                                         Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                         Content="靠左" Tag="Left" Checked="OnToolbarAlignmentChanged" />
                            <RadioButton x:Name="ToolbarCenterChoice" GroupName="ToolbarAlignment"
                                         Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                         Content="居中" Tag="Center" Checked="OnToolbarAlignmentChanged" />
                            <RadioButton x:Name="ToolbarRightChoice" GroupName="ToolbarAlignment"
                                         Style="{StaticResource ToolbarAlignmentChoiceStyle}"
                                         Content="靠右" Tag="Right" Checked="OnToolbarAlignmentChanged" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,18,0,8">
                    <TextBlock Text="界面透明度" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" />
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="0.98" SmallChange="0.01" LargeChange="0.05"
                        ValueChanged="OnOpacityChanged" />

                <Grid Margin="0,21,0,8">
                    <TextBlock Text="图标尺寸" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="IconSizeValue" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SettingsMutedBrush}" FontSize="12" />
                </Grid>
                <Slider x:Name="IconSizeSlider" Minimum="32" Maximum="72" TickFrequency="4" IsSnapToTickEnabled="True"
                        ValueChanged="OnIconSizeChanged" />

                <Grid Margin="0,22,0,10">
                    <TextBlock Text="桌面背景" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" />
                    <Button x:Name="ImportWallpaperButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="34" Padding="13,0" Style="{StaticResource SettingsButtonStyle}"
                            Content="导入图片" Click="OnImportWallpaperClick" />
                </Grid>
                <ItemsControl x:Name="WallpaperOptionsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="2" Margin="30,0">
                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource SettingsStrokeBrush}" />
                <CheckBox x:Name="LaunchAtStartupChoice" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Style="{StaticResource StartupCheckBoxStyle}" Content="开机自启动" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SettingsButtonStyle}" Content="取消" Margin="0,0,10,0" Click="OnCancelClick" />
                    <Button Style="{StaticResource SettingsPrimaryButtonStyle}" Content="保存设置" Click="OnSaveClick" />
                </StackPanel>
            </Grid>

            <Image x:Name="ThemeTransitionImage" Grid.RowSpan="3" Stretch="Fill"
                   IsHitTestVisible="False" Opacity="0" Visibility="Collapsed" Panel.ZIndex="100" />
        </Grid>
    </Border>
</Window>
