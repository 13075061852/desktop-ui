<Window x:Class="DeskNest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="栖格 · DeskNest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="1600" Height="900"
        Left="0" Top="0">
    <Grid Background="{x:Null}">
        <Canvas x:Name="DesktopCanvas" Background="{x:Null}" />

        <Border x:Name="ToolbarBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,18,0,0" Padding="10,7"
                Background="{StaticResource PanelStrongBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="#05080D" />
            </Border.Effect>
            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="5,0,10,0" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="栖" Foreground="#14221F" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BrandText" Text="栖格" Margin="8,0,4,0" FontWeight="SemiBold"
                               FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="1" Height="20" Background="{StaticResource StrokeBrush}" Margin="0,0,4,0" />
                <Button Style="{StaticResource ToolbarButtonStyle}" Content="＋ 新建分区" Click="OnNewZoneClick" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="✦ 一键整理" Margin="4,0" Click="OnOrganizeClick" />
                <Button x:Name="LockButton" Style="{StaticResource ToolbarButtonStyle}" Content="◇ 锁定布局" Click="OnToggleLockClick" />
                <Button x:Name="IconVisibilityButton" Style="{StaticResource ToolbarButtonStyle}" Content="◉ 隐藏原图标" Click="OnToggleIconsClick" />
                <Button Style="{StaticResource IconButtonStyle}" Content="⚙" Margin="4,0,0,0" ToolTip="设置" Click="OnSettingsClick" />
            </StackPanel>
        </Border>

        <Border x:Name="StatusBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,22" Padding="13,7" CornerRadius="14"
                Background="{StaticResource PanelStrongBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
