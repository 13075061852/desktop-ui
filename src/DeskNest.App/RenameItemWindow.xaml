<Window x:Class="DeskNest.App.RenameItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名"
        Width="430" Height="272"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="#FFF7F9FC">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FC171D27" />
        <SolidColorBrush x:Key="DialogInputBrush" Color="#FF202936" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#FFF7F9FC" />
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#FFAAB5C5" />
        <SolidColorBrush x:Key="DialogStrokeBrush" Color="#42FFFFFF" />
        <SolidColorBrush x:Key="DialogHoverBrush" Color="#24FFFFFF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource DialogHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF14231F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource DialogMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource DialogHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource DialogInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputSurface" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogStrokeBrush}" BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,13,0" Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarMouseDown">
                    <TextBlock x:Name="DialogTitleText" Text="重命名" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource DialogTextBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource CloseButtonStyle}" IsCancel="True" ToolTip="关闭" />
                </Grid>

                <Grid Grid.Row="1" Margin="24,7,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ActionTitleText" Text="重命名文件" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource DialogTextBrush}" />
                    <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,6,0,12"
                               Text="输入新名称" Foreground="{StaticResource DialogMutedBrush}" FontSize="12" />
                    <TextBox x:Name="NameTextBox" Grid.Row="2"
                             Style="{StaticResource DialogTextBoxStyle}"
                             KeyDown="OnNameKeyDown" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button MinWidth="78" Content="取消" IsCancel="True"
                                Style="{StaticResource DialogButtonStyle}" />
                        <Button MinWidth="86" Margin="10,0,0,0" Content="确认" IsDefault="True"
                                Style="{StaticResource PrimaryDialogButtonStyle}" Click="OnConfirmClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
